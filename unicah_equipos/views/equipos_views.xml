<odoo>
<record id="equipo_list" model="ir.ui.view"><field name="name">unicah.equipo.list</field><field name="model">unicah.equipo</field><field name="arch" type="xml"><list><field name="codigo"/><field name="name"/><field name="categoria"/><field name="disponible"/><field name="active" optional="hide"/></list></field></record>
<record id="equipo_form" model="ir.ui.view"><field name="name">unicah.equipo.form</field><field name="model">unicah.equipo</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="codigo"/><field name="categoria"/><field name="disponible"/><field name="active"/></group><notebook><page string="Historial"><field name="prestamo_ids" readonly="1"/></page></notebook></sheet><chatter/></form></field></record>
<record id="prestamo_list" model="ir.ui.view"><field name="name">unicah.prestamo.list</field><field name="model">unicah.prestamo</field><field name="arch" type="xml"><list decoration-success="state == 'devuelto'"><field name="name"/><field name="equipo_id"/><field name="partner_id"/><field name="fecha_inicio"/><field name="fecha_fin"/><field name="duracion_dias"/><field name="state"/></list></field></record>
<record id="prestamo_form" model="ir.ui.view"><field name="name">unicah.prestamo.form</field><field name="model">unicah.prestamo</field><field name="arch" type="xml"><form><header><button name="action_prestar" type="object" string="Entregar equipo" invisible="state != 'borrador'" class="oe_highlight"/><button name="action_devolver" type="object" string="Registrar devolución" invisible="state != 'prestado'"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="name"/><field name="equipo_id" readonly="state != 'borrador'"/><field name="partner_id" readonly="state != 'borrador'"/><field name="responsable_id"/></group><group><field name="fecha_inicio" readonly="state != 'borrador'"/><field name="fecha_fin" readonly="state != 'borrador'"/><field name="fecha_devolucion"/><field name="duracion_dias"/></group></group><field name="observaciones"/></sheet><chatter/></form></field></record>
<record id="prestamo_search" model="ir.ui.view"><field name="name">unicah.prestamo.search</field><field name="model">unicah.prestamo</field><field name="arch" type="xml"><search><field name="partner_id"/><field name="equipo_id"/><filter name="activos" string="Prestados" domain="[('state', '=', 'prestado')]"/><filter name="equipo" string="Equipo" context="{'group_by': 'equipo_id'}"/></search></field></record>
<record id="action_equipo" model="ir.actions.act_window"><field name="name">Equipos</field><field name="res_model">unicah.equipo</field><field name="view_mode">list,form</field></record>
<record id="action_prestamo" model="ir.actions.act_window"><field name="name">Préstamos</field><field name="res_model">unicah.prestamo</field><field name="view_mode">list,form</field></record>
<menuitem id="menu_equipos" name="Equipos UNICAH" sequence="60" groups="base.group_user"/>
<menuitem id="menu_prestamos" name="Préstamos" parent="menu_equipos" action="action_prestamo" sequence="10"/>
<menuitem id="menu_inventario" name="Equipos" parent="menu_equipos" action="action_equipo" sequence="20"/>
</odoo>